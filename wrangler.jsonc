{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libro-momentum",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/descargas/*"]
  },
  "observability": { "enabled": true },
  // Valores públicos. Los secretos (webhook de n8n, palabra clave del ticket)
  // se cargan con `npx wrangler secret put` o en el panel de Cloudflare.
  "vars": {
    "SITIO": "libro.momentumhub.cloud"
  }
}
